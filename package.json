{
  "name": "health-os",
  "version": "1.4.0",
  "private": true,
  "description": "Health OS - Supabase cloud health, nutrition, training and care",
  "type": "module",
  "scripts": {
    "test:mcp": "npm run mcp:bundle && node --import tsx --test src/hosted/mcp/hosted.test.ts src/hosted/mcp/cloud-hosted.test.ts src/hosted/mcp/cloud-gateway.test.ts src/server/mcp.test.ts src/shared/health-action-registry.test.ts src/shared/mcp-expanded.test.ts src/shared/mcp-execution.test.ts",
    "dev": "vite --host 127.0.0.1 --port 10000",
    "worker:setup": "node scripts/setup-worker.mjs",
    "worker:login": "tsx --tsconfig tsconfig.server.json src/server/worker/index.ts --login",
    "worker:start": "tsx --tsconfig tsconfig.server.json src/server/worker/index.ts",
    "worker:doctor": "tsx --tsconfig tsconfig.server.json src/server/worker/index.ts --doctor",
    "worker:verify": "node scripts/verify-worker.mjs",
    "voice:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-whisper.ps1",
    "dev:server": "tsx watch --tsconfig tsconfig.server.json src/server/index.ts",
    "dev:client": "vite",
    "build": "npm run build:client",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build:installer": "node build-installer.cjs",
    "start": "node scripts/serve-web.mjs",
    "start:prod": "node scripts/serve-web.mjs",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "node scripts/test-runner.mjs",
    "test:e2e": "playwright test",
    "verify": "npm run typecheck && npm test && npm run build && npm run test:web",
    "verify:health-os-6": "npm run typecheck && npm test && npm run build && playwright test -c playwright.health-os-6.config.ts",
    "dev:desktop": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "build:desktop": "npm run build:client && npm run build:server",
    "start:desktop": "tsx --tsconfig tsconfig.server.json src/server/index.ts",
    "typecheck:web": "tsc -p tsconfig.client.json --noEmit",
    "test:web": "playwright test -c playwright.web.config.ts",
    "test:release": "playwright test -c playwright.health-release.config.ts",
    "build:android": "node scripts/prepare-original-android.mjs",
    "build:apk": "npm run build:android && pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/package-original-android.ps1 -VersionCode 2026101605 -VersionName 1.4.0",
    "voice:setup:cpp": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-whisper-cpp.ps1",
    "mcp:dev": "wrangler dev -c wrangler.mcp.jsonc",
    "mcp:deploy": "wrangler deploy -c wrangler.mcp.jsonc",
    "mcp:check": "tsc -p tsconfig.hosted.json",
    "mcp:bundle": "wrangler deploy -c wrangler.mcp.jsonc --dry-run --outdir output/hosted-mcp-build"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.3",
    "@duckdb/node-api": "^1.5.5-r.4",
    "@langchain/langgraph": "1.4.21",
    "@lhncbc/ucum-lhc": "^7.1.9",
    "@medplum/core": "^5.2.0",
    "@medplum/definitions": "^5.2.0",
    "@medplum/fhirtypes": "^5.2.0",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@modelcontextprotocol/server": "2.3.1",
    "@noble/ciphers": "^1.3.0",
    "@noble/hashes": "^1.8.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/core": "2.12.0",
    "@opentelemetry/sdk-metrics": "2.12.0",
    "@opentelemetry/sdk-trace-web": "2.12.0",
    "@pixiv/three-vrm": "^3.5.5",
    "@pixiv/three-vrm-animation": "^3.5.5",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@tanstack/react-query": "^5.102.8",
    "chart.js": "^4.4.8",
    "cql-exec-fhir": "^2.2.0",
    "cql-execution": "^3.3.2",
    "dcmjs": "^0.52.0",
    "express": "^4.21.2",
    "googleapis": "^174.0.1",
    "idb": "^8.0.3",
    "juice": "^12.1.2",
    "lucide-react": "^1.49.0",
    "mcp-server-sqlite": "^0.0.2",
    "nodemailer": "^6.10.1",
    "pdfjs-dist": "^6.3.289",
    "pdfkit": "^0.20.2",
    "pino": "^10.3.1",
    "puppeteer": "^25.8.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rxjs": "^7.8.2",
    "tesseract.js": "^7.0.0",
    "three": "^0.186.1",
    "web-vitals": "^6.2.3",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/workers-types": "5.20261011.1",
    "@gltf-transform/cli": "^4.5.0",
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "@playwright/test": "^1.63.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.10",
    "@types/nodemailer": "^6.4.17",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "gltf-validator": "^2.0.0-dev.3.10",
    "innosetup-compiler": "^6.3.1",
    "leva": "^0.10.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^6.2.2",
    "wrangler": "4.149.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-win32-x64-msvc": "^4.62.2"
  }
}
