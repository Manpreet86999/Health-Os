await fs.writeFile(path.join(output, 'index.html'), html);
const browser = await chromium.launch({ channel: 'msedge', headless: true });
try {
  const page = await browser.newPage();
  const checks = [];
  for (const width of [900, 390, 320]) {
    await page.setViewportSize({ width, height: 1000 });
    await page.setContent(html, { waitUntil: 'load' });
    const layout = await page.evaluate(() => ({ viewport: innerWidth, width: document.documentElement.scrollWidth, brokenImages: [...document.images].filter(i => !i.complete || !i.naturalWidth).length }));
    if (layout.width > width || layout.brokenImages) throw new Error(JSON.stringify(layout));
    await page.screenshot({ path: path.join(output, `report-${width}.png`), fullPage: true });
    await page.locator('summary').click();
    if (!await page.getByText('Walking lunge', { exact: true }).isVisible()) throw new Error('Exercise detail did not expand');
    await page.locator('#toggle').click();
    if (!await page.getByRole('heading', { name: 'Full-day totals unavailable' }).isVisible()) throw new Error('Incomplete state did not render');
    const missingWidth = await page.evaluate(() => document.documentElement.scrollWidth);
    if (missingWidth > width) throw new Error('Incomplete state overflow');
    if (width === 390) await page.screenshot({ path: path.join(output, 'incomplete-390.png'), fullPage: true });
    checks.push({ ...layout, incompleteWidth: missingWidth, exerciseDetails: 'passed', incompleteState: 'passed' });
  }
  await page.setViewportSize({ width: 900, height: 1000 });
  await page.setContent(html);
  await page.screenshot({ path: path.join(output, 'overview.png'), fullPage: false });
  await fs.writeFile(path.join(output, 'checks.json'), JSON.stringify(checks, null, 2));
  console.log(JSON.stringify({ output, checks }, null, 2));
} finally { await browser.close(); }


